NVIDIA_GLM52_MODEL=z-ai/glm-5.2
NVIDIA_GLM52_PROVIDER=z-ai

# Model 2: Mistral AI — Mamba-Transformer MoE
# Role: LONG-CONTEXT — 1M token context, agentic reasoning, planning
