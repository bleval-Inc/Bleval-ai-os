# ── OpenAI (GPT) ────────────────────────────────────────────────
# Excels at: general purpose, creative writing, structured output
OPENAI_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# NVIDIA NIM — Multi-Model Intelligence Layer
# Master API Key for all NVIDIA NIM models via integrate.api.nvidia.com
# ═══════════════════════════════════════════════════════════════════

# Master key provides access to all NVIDIA NIM models
NVIDIA_API_KEY=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
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Individual model keys (all set to master key for full access)
# Model 1: Z.ai GLM-5.2
# Role: FLAGSHIP — Strategic reasoning, executive decisions, long-horizon planning
