NVIDIA_STEPFUN_MODEL=stepfun-ai/step-3.7-flash
NVIDIA_STEPFUN_PROVIDER=stepfun-ai

# Model 4: NVIDIA — General Purpose
# Role: GENERAL — Text generation, coding, agentic use cases
