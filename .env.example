# ═══════════════════════════════════════════════════════════════════
# AXIOM OS — PRODUCTION ENVIRONMENT CONFIGURATION
# AXIOM BRAIN: Centralized Intelligence Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in all values
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# CORE SYSTEM SETTINGS
# ═══════════════════════════════════════════════════════════════════

# Environment: development, staging, production
AXIOM_ENV=production

# Debug mode - MUST be false in production
DEBUG=false

# Runtime directories
AXIOM_STATE_DIR=./backend/runtime/state
AXIOM_EVENT_LOG_DIR=./backend/runtime/events
AXIOM_LOG_DIR=./backend/runtime/logs

# Secret files directory (for Docker/K8s secrets)
AXIOM_SECRETS_DIR=/run/secrets

# ═══════════════════════════════════════════════════════════════════
# AXIOM BRAIN — MODEL PROVIDER CONFIGURATION
# Smart Multi-Model Intelligence Router with capability-aware routing
# ═══════════════════════════════════════════════════════════════════

# ── Anthropic (Claude) ─────────────────────────────────────────────
# Role: Fallback reasoning provider
# Best for: Complex reasoning, code analysis, long-form content
ANTHROPIC_API_KEY=

# ── OpenAI (GPT) ──────────────────────────────────────────────────
# Role: Fallback general provider
# Best for: General purpose, creative writing, structured output
OPENAI_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# NVIDIA NIM — Multi-Model Intelligence Layer (PRIMARY)
# All keys use nvapi-* format via NVIDIA's OpenAI-compatible API
# https://integrate.api.nvidia.com/v1
# ═══════════════════════════════════════════════════════════════════

# Model 1: Z.ai GLM-5.2 (FLAGSHIP)
# Role: STRATEGIC — Executive decisions, long-horizon planning, agentic workflows
# Best for: Strategic reasoning, coding, complex analysis, high-level planning
NVIDIA_GLM52_KEY=
NVIDIA_GLM52_MODEL=z-ai/glm-5.2
NVIDIA_GLM52_PROVIDER=z-ai

# Model 2: Mistral Mamba-Transformer MoE (LONG-CONTEXT)
# Role: LONG_CONTEXT — 1M token context, agentic reasoning, tool calling
# Best for: Long document analysis, code generation, planning, tool orchestration
NVIDIA_MISTRAL_MAMBA_KEY=
NVIDIA_MISTRAL_MAMBA_MODEL=mistralai/mistral-nemotron
NVIDIA_MISTRAL_MAMBA_PROVIDER=mistral-ai

# Model 3: Stepfun Sparse MoE (MULTIMODAL)
# Role: AGENTIC/CREATIVE — Enterprise reasoning, multimodal, mixed tasks
# Best for: Multimodal understanding, enterprise workflows, agentic tasks
NVIDIA_STEPFUN_KEY=
NVIDIA_STEPFUN_MODEL=stepfun-ai/step-3.7-flash
NVIDIA_STEPFUN_PROVIDER=stepfun-ai

# Model 4: NVIDIA General Purpose (GENERAL)
# Role: GENERAL — Everyday text, coding, quick agentic tasks
# Best for: Quick queries, general text generation, simple coding
NVIDIA_GENERAL_KEY=
NVIDIA_GENERAL_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_GENERAL_PROVIDER=nvidia

# NVIDIA API Base URL
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# ═══════════════════════════════════════════════════════════════════
# INTEGRATION PROVIDER API KEYS
# All providers loaded via organization YAML configs
# ═══════════════════════════════════════════════════════════════════

# ── Bleval Inc (Development Organization) ─────────────────────────
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
HUBSPOT_API_KEY=
CALENDLY_API_KEY=
BLEVAL_EMAIL_CLIENT_ID=
BLEVAL_EMAIL_CLIENT_SECRET=

# ── House of Valta (Trading Organization) ─────────────────────────
# Uses same Slack/Calendly as Bleval
# Market Data (choose one backend)
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
# TradingView
TRADINGVIEW_SESSION=
# MetaTrader 5 (READ ONLY) - Local installation required
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# ── Personal Organization ─────────────────────────────────────────
PERSONAL_CALENDAR_CLIENT_ID=
PERSONAL_CALENDAR_CLIENT_SECRET=
PERSONAL_EMAIL_CLIENT_ID=
PERSONAL_EMAIL_CLIENT_SECRET=

# ── Communication ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+15551234567

# ── Email (SMTP/IMAP fallback) ────────────────────────────────────
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ── CalDAV (Personal Calendar fallback) ───────────────────────────
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# ═══════════════════════════════════════════════════════════════════
# VOICE SYSTEM
# ══════════════════════════════════════════════════════════════════
VOICE_WEBSOCKET_URL=ws://localhost:8000/voice/ws
VOICE_REST_URL=http://localhost:8000/api/voice

# ═══════════════════════════════════════════════════════════════════
# EXECUTIVE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
# Morning routine time (24h format)
MORNING_ROUTINE_HOUR=5
MORNING_ROUTINE_MINUTE=0

# Executive schedules (cron expressions)
JENSON_SCHEDULE="0 9 * * 1-5"      # Weekdays 9 AM
VALTA_PRIME_SCHEDULE="*/15 * * * *" # Every 15 min during market hours
YAMAKO_SCHEDULE="0 5 * * *"         # Daily 5 AM

# Board room meeting schedules
BOARD_DAILY_CRON="0 8 * * *"        # Daily 8 AM
BOARD_WEEKLY_CRON="0 9 * * 1"       # Weekly Monday 9 AM
BOARD_MONTHLY_CRON="0 10 1 * *"     # Monthly 1st 10 AM

# ═══════════════════════════════════════════════════════════════════
# FOUNDER AUTHORITY
# ═══════════════════════════════════════════════════════════════════
FOUNDER_ID=founder
FOUNDER_EMAIL=founder@axiom.local
FOUNDER_NAME=Founder

# ═══════════════════════════════════════════════════════════════════
# SECURITY & AUDIT
# ═══════════════════════════════════════════════════════════════════
# Audit log retention (days)
AUDIT_LOG_RETENTION_DAYS=365

# Rate limiting defaults (per minute)
DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_RATE_LIMIT_BURST=10

# ═══════════════════════════════════════════════════════════════════
# PERFORMANCE & OBSERVABILITY
# ═══════════════════════════════════════════════════════════════════
# Enable OpenTelemetry tracing
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=axiom-os

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# ═══════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════════
# Enable real providers only (no mock fallback)
REAL_PROVIDERS_ONLY=true

# Enable QC pipeline
QC_PIPELINE_ENABLED=true

# Enable voice system
VOICE_SYSTEM_ENABLED=true

# Enable background autonomy
BACKGROUND_AUTONOMY_ENABLED=true

# ═══════════════════════════════════════════════════════════════════
